database/misc/serviceaccount.json
# Schedule spreadsheets/CSVs for format_schedule.py stay out of git
database/misc/**/*.xlsx
database/misc/**/*.csv

# Local env files (contain real secrets: JWT_SECRET, YALIES_API_KEY, etc.)
.env.local
.env*.local
**/.env.local
**/.env*.local

# v3 migration reports (anomaly refs may hold emails)
migration-report*.json

# iCloud sync conflict copies ("name 2.tsx", "folder 2/") when the repo sits in a synced folder
* 2.*
* 2/

# Repository documentation: top-level guides and directory README.md files only.
*.[mM][dD]
!README.md
!/CONTRIBUTING.md

# Runtime/debug logs are local artifacts.
*.log
