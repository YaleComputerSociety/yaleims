rules_version = '2';

// Public reads, no client writes.
//
// The browser never writes to Firestore: every write goes through the server
// (Next.js API routes), which use the Admin SDK and are not
// subject to these rules. The site has no Firebase Auth, so the browser can't be
// told apart from anyone else; reads stay public for now (locking them down is
// a later phase).
//
// Exception: API keys are never readable from the browser
// (`user_api_keys/{key}` and `users/{email}/api_keys/{id}`). The public API that
// used them was removed, but the old keys (and their owners' emails) stay in
// Firestore, so they stay hidden.
//
// Rules are OR-ed (any allow wins), so a blanket `match /{document=**}` read
// rule could not be narrowed later. Every document is matched exactly once:
// top-level docs by the first block, all nested docs by the second.
service cloud.firestore {
  match /databases/{database}/documents {

    match /{collection}/{docId} {
      allow read: if collection != "user_api_keys";
      allow write: if false;
    }

    match /{collection}/{docId}/{subcollection}/{rest=**} {
      allow read: if collection != "user_api_keys"
        && !(collection == "users" && subcollection == "api_keys");
      allow write: if false;
    }
  }
}
