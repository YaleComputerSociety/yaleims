rules_version = '2';

// Deny by default: the browser reads only what its live listeners need, and
// never writes.
//
// Every write and every other read goes through the server (Next.js API
// routes), which uses the Admin SDK and is not subject to these rules. The
// site has no Firebase Auth, so the browser can't be told apart from anyone
// else: whatever is readable here is public.
//
// Public, for the live listeners (src/hooks):
// - a season doc, `seasons/{seasonId}` (useChampionship: the champion banner);
// - a season's standings, `seasons/{seasonId}/colleges/{collegeId}`
//   (useStandings). A college's subcollections (teams, MVPs) stay denied.
//
// Everything else is denied: users, usernames, players, matches and their
// rosters and score reports, teams, sports, brackets, MVPs, the audit log,
// `config`, and the pre-v3 collections (the pre-v3 build read them from the
// browser; going back to it needs the earlier rules too).
service cloud.firestore {
  match /databases/{database}/documents {

    match /seasons/{seasonId} {
      allow read: if true;

      match /colleges/{collegeId} {
        allow read: if true;
      }
    }
  }
}
