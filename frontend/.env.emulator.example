# Emulator mode flags
# ---------------------------------------------------------------------------
# Copy the relevant lines into frontend/.env.local (which is gitignored) to run
# the frontend against the local Firebase Emulator Suite instead of production.
#
# `npm run dev:emulator` sets NEXT_PUBLIC_USE_EMULATOR=true for you, so you only
# need these if you want to override hosts/ports or run plain `npm run dev`
# against the emulator.

# Master switch. When "true":
#   - lib/firebase.ts points the client Firestore SDK at the emulator
#   - src/utils/functionUrls.ts routes all Cloud Function calls to the
#     local Functions emulator
NEXT_PUBLIC_USE_EMULATOR=true

# Firestore emulator (defaults shown; must match database/firebase.json)
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080

# Functions emulator host:port (defaults shown; must match database/firebase.json)
NEXT_PUBLIC_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# NOTE: you still need your normal NEXT_PUBLIC_FIREBASE_* config values in
# .env.local — the emulator reuses the same projectId (yims-125a2).
