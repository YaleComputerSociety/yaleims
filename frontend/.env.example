# Local development settings: copy to .env.local (never committed).
# Enough for `npm run dev:emulator` with the synthetic seed. Production's
# values are in apphosting.yaml and Cloud Secret Manager.

# The emulator's project (npm run emulator uses the same).
NEXT_PUBLIC_FIREBASE_PROJECT_ID=yims-125a2

# Signs local session cookies (npm run dev:token): any long random string,
# e.g. the output of `openssl rand -hex 32`.
JWT_SECRET=

# Only for signing in through Yale's CAS locally (on :3000): the site's own
# address, and a Yalies API key (https://yalies.io) for the name lookup.
BASE_URL=http://localhost:3000
YALIES_API_KEY=

# The emulator: `npm run dev:emulator` turns it on (NEXT_PUBLIC_USE_EMULATOR=true
# points both the browser and the server at it). Another host or port only if
# you moved it (must match database/firebase.json):
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
# NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
