{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emulator": "NEXT_PUBLIC_USE_EMULATOR=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx scripts/test-integration.mts",
    "emulator": "npx -y firebase-tools@14 emulators:start --only firestore --config ../database/firebase.json --project demo-yims",
    "seed": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed.mts",
    "dev:token": "node --env-file-if-exists=.env.local --import tsx scripts/dev-token.mts",
    "make-admin": "node --env-file-if-exists=.env.local --import tsx scripts/make-admin.mts",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:doctor": "node --env-file-if-exists=.env.local scripts/dev-doctor.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:watch": "vitest --project unit",
    "test:emulator": "NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-yims npx -y firebase-tools@14 emulators:exec --only firestore --project demo-yims --config ../database/firebase.json \"npm run test:integration\""
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "date-fns": "^3.6.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.503.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-loading-skeleton": "^3.5.0",
    "react-toastify": "^11.2.0",
    "server-only": "^0.0.1",
    "xml2js": "^0.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/xml2js": "^0.4.14",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.9.0 <23"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree@8.72.1": {
      "minimatch": "^11.0.1"
    },
    "@firebase/firestore@4.17.2": {
      "@grpc/grpc-js": "^1.14.7"
    },
    "@google-cloud/firestore@9.4.0": {
      "@google-cloud/firestore-api": "^0.7.1"
    }
  }
}
